# ============================================================================
# نموذج بيئة النشر على السيرفر — انسخه إلى .env بجانب compose.yaml
#   cp deploy/.env.deploy.example .env
#
# نموذج التشغيل: كل مستخدم يضيف مفتاح Gemini الخاص به من داخل التطبيق.
# لا يوجد مفتاح مشترك على السيرفر (AUTH_MODE=user)، لذلك لا تحتاج مفتاحًا هنا.
# ============================================================================

# ---------- نموذج المفاتيح ----------
# اتركه user: التطبيق يطلب مفتاح كل مستخدم ولا يستخدم أي مفتاح على الخادم.
# غيّره إلى hybrid فقط إن أردت مفتاحًا احتياطيًا مشتركًا (اقرأ التحذير أدناه).
AUTH_MODE=user

# ---------- مفتاح الخادم (اتركه فارغًا في الوضع user) ----------
# يُقرأ فقط عندما AUTH_MODE=hybrid.
# تحذير: حدود Gemini تُطبَّق على مستوى المشروع لا المفتاح، لذا مفتاح مشترك يعني
# حصة واحدة يتقاسمها كل المستخدمين — ولا يصلح للاستخدام العام.
GEMINI_API_KEY=

# ---------- سلسلة الموديلات البديلة ----------
GEMINI_MODELS=gemini-3.8-flash,gemini-3.1-flash-lite,gemini-flash-latest,gemini-3.6-flash
GEMINI_MAX_ATTEMPTS=3
GEMINI_BACKOFF_BASE_MS=600
GEMINI_BACKOFF_MAX_MS=6000
GEMINI_TIMEOUT_MS=115000

# ---------- حماية الخادم ----------
# سقف الطلبات لكل IP في الساعة (0 = بلا سقف). يحمي السيرفر من الإساءة.
MAX_REQUESTS_PER_IP_PER_HOUR=600

# ---------- إعدادات الخادم ----------
HOST=0.0.0.0
# المنفذ الداخلي المعتمد. لا تغيّره إلا إن عدّلت compose.yaml أيضًا.
PORT=3500
APP_VERSION=1.0.0

# ---------- نفق Cloudflare (إلزامي) ----------
# من لوحة Cloudflare: Zero Trust → Networks → Tunnels → أنشئ نفقًا →
# اختر Docker → انسخ التوكن الطويل هنا.
#
# ثم في تبويب Public Hostname أضف دومينك الفرعي بهدف:
#     Type: HTTP    URL: app:3500
# (استخدم اسم الخدمة app لا localhost، وأبقِ 3500 في الهدف)
CLOUDFLARE_TUNNEL_TOKEN=

# ---------- منفذ الفحص المحلي على السيرفر ----------
# اربطه على 127.0.0.1 فقط ليبقى غير مكشوف للإنترنت.
APP_BIND=127.0.0.1
APP_PORT=3500

# ---------- اسم الصورة ----------
# عند السحب من GitHub Container Registry استخدم:
#   APP_IMAGE=ghcr.io/<حسابك>/ai-translator:latest
APP_IMAGE=ai-translator:latest

# ---------- حد ذاكرة Node ----------
NODE_OPTIONS=--max-old-space-size=640
