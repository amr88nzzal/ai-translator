# ---------- المترجم الصوتي والسياقي الذكي — نموذج الإعدادات ----------
# انسخ هذا الملف إلى .env ثم املأ القيم. لا ترفع ملف .env إلى Git أبدًا.

# ============================================================================
# نموذج المفاتيح (مهم)
# ============================================================================
# AUTH_MODE=user    (الافتراضي) كل مستخدم يضيف مفتاح Gemini الخاص به.
#                   مفتاح الخادم غير مستخدم إطلاقًا حتى لو وُجد GEMINI_API_KEY.
#                   هذا هو الوضع الموصى به للنشر العام: كلفتك صفر، والحصة موزّعة
#                   على المستخدمين، ولا يمكن لأحد استنزاف مفتاحك.
#
# AUTH_MODE=hybrid  مفتاح المستخدم أولًا، ومفتاح الخادم خطة بديلة عند غيابه.
#                   مناسب للاستخدام الداخلي/التجريبي فقط، لأن كل المستخدمين
#                   يتقاسمون نفس حصة المشروع: حدود Gemini تُطبَّق على المشروع
#                   لا على المفتاح.
AUTH_MODE=user

# مفتاح الخادم — يُقرأ فقط في الوضع hybrid. اتركه فارغًا في الوضع user.
GEMINI_API_KEY=

# ---------- سلسلة الموديلات البديلة (تُستخدم مع مفتاح المستخدم أيضًا) ----------
GEMINI_MODELS=gemini-3.8-flash,gemini-3.1-flash-lite,gemini-flash-latest,gemini-3.6-flash

# ---------- مضبوطات الصمود ----------
GEMINI_MAX_ATTEMPTS=3
GEMINI_BACKOFF_BASE_MS=600
GEMINI_BACKOFF_MAX_MS=6000
GEMINI_TIMEOUT_MS=115000

# ---------- حماية الخادم ----------
# سقف الطلبات لكل IP في الساعة (0 = بلا سقف). يحمي السيرفر نفسه لا حصة Gemini.
MAX_REQUESTS_PER_IP_PER_HOUR=600

# ---------- الخادم ----------
# المنفذ المعتمد لهذا المشروع: 3500
PORT=3500
HOST=0.0.0.0
NODE_ENV=development
APP_VERSION=1.0.0
